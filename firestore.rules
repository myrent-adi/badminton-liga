// Silent Zagreb Badminton — Firestore sigurnosna pravila.
// Ovo je REFERENTNA DATOTEKA. Firestore ne ucitava pravila iz GitHuba automatski.
// Nakon provjere, kopirati cijeli sadrzaj u Firebase Console > Firestore > Rules > Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasAdminDoc() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner() {
      return hasAdminDoc()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }
    function isAdmin() {
      return hasAdminDoc()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    function isMember() {
      return isAdmin() || (
        signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'status'])
        && request.resource.data.keys().hasAll(['displayName', 'email', 'status'])
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if false;
    }
    match /admins/{adminId} {
      allow get: if signedIn() && (request.auth.uid == adminId || isOwner());
      allow list: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role == 'admin';
      allow update: if false;
      allow delete: if isOwner() && resource.data.role == 'admin';
    }
    match /players/{playerId} {
      allow get, list: if isMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool;
      allow delete: if false;
    }
    // Only owner and admins can manage sessions. Approved members can read.
    match /trainings/{trainingId} {
      allow get, list: if isMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'start', 'end', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['date', 'start', 'end', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.start is string
        && request.resource.data.start.size() == 5
        && request.resource.data.start.matches('[0-9]{2}:[0-9]{2}')
        && request.resource.data.end is string
        && request.resource.data.end.size() == 5
        && request.resource.data.end.matches('[0-9]{2}:[0-9]{2}')
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'start', 'end', 'active'])
        && request.resource.data.date is string
        && request.resource.data.start is string
        && request.resource.data.end is string
        && request.resource.data.active is bool;
      allow delete: if false;
      // Administrator can record attendance for players without Google accounts.
      // The document ID is the player's Firestore ID, never a free-form name.
      match /manualAttendance/{playerId} {
        allow get, list: if isMember();
        allow create, update: if isAdmin()
          && exists(/databases/$(database)/documents/players/$(playerId))
          && request.resource.data.keys().hasOnly(['choice', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['choice', 'updatedAt', 'updatedBy'])
          && request.resource.data.choice in ['yes', 'no', 'maybe', 'pending']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /votes/{userId} {
        allow get, list: if isMember();
        allow create, update: if isMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['choice', 'updatedAt', 'displayName'])
          && request.resource.data.keys().hasAll(['choice', 'updatedAt'])
          && request.resource.data.choice in ['yes', 'no', 'maybe']
          && (
            !request.resource.data.keys().hasAny(['displayName'])
            || (
              request.auth.token.name is string
              && request.resource.data.displayName == request.auth.token.name
            )
          )
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
    // Results are shared with approved members. Only admins may add results.
    match /results/{resultId} {
      allow get, list: if isMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'type', 'teamA', 'teamB', 'teamANames', 'teamBNames',
          'setsA', 'setsB', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'date', 'type', 'teamA', 'teamB', 'teamANames', 'teamBNames',
          'setsA', 'setsB', 'createdBy', 'createdAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.type in ['singles', 'doubles']
        && request.resource.data.teamA is list
        && request.resource.data.teamB is list
        && request.resource.data.teamANames is list
        && request.resource.data.teamBNames is list
        && request.resource.data.teamA.size() == (request.resource.data.type == 'singles' ? 1 : 2)
        && request.resource.data.teamB.size() == request.resource.data.teamA.size()
        && request.resource.data.teamANames.size() == request.resource.data.teamA.size()
        && request.resource.data.teamBNames.size() == request.resource.data.teamB.size()
        && request.resource.data.teamA[0] is string
        && request.resource.data.teamB[0] is string
        && request.resource.data.teamANames[0] is string
        && request.resource.data.teamBNames[0] is string
        && request.resource.data.teamANames[0].size() <= 80
        && request.resource.data.teamBNames[0].size() <= 80
        && (request.resource.data.type == 'singles' || (
          request.resource.data.teamA[1] is string
          && request.resource.data.teamB[1] is string
          && request.resource.data.teamANames[1] is string
          && request.resource.data.teamBNames[1] is string
          && request.resource.data.teamANames[1].size() <= 80
          && request.resource.data.teamBNames[1].size() <= 80
        ))
        && request.resource.data.teamA.hasOnly(request.resource.data.teamA)
        && request.resource.data.teamA.toSet().intersection(request.resource.data.teamB.toSet()).size() == 0
        && request.resource.data.teamA.toSet().size() == request.resource.data.teamA.size()
        && request.resource.data.teamB.toSet().size() == request.resource.data.teamB.size()
        && request.resource.data.setsA is int
        && request.resource.data.setsB is int
        && (
          (request.resource.data.setsA == 2 && request.resource.data.setsB in [0, 1])
          || (request.resource.data.setsB == 2 && request.resource.data.setsA in [0, 1])
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
